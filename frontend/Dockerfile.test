FROM node:18-alpine

# filepath: /C:/Users/Student/Documents/Module Dev Containers/CMP9134-2425-basicWebApp/frontend/Dockerfile.test
WORKDIR /app

# Copy package.json and package-lock.json
COPY package.json package-lock.json ./

# Use npm ci to install dependencies
RUN npm ci --verbose

# Create mock directories and setup files
RUN mkdir -p /app/src/tests/__mocks__ && \
    echo "module.exports = {};" > /app/src/tests/__mocks__/styleMock.js

RUN mkdir -p /app/src/tests && \
    echo "import '@testing-library/jest-dom';" > /app/src/tests/setupTests.js

# Remove conflicting config files
RUN rm -f /app/babel.config.js /app/postcss.config.js /app/jest.config.js

# Copy the source code into WORKDIR /app
COPY . .

# Default command
CMD ["npm", "test"]